<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ActivityAnalyzer.ViewModel"
             x:Class="ActivityAnalyzer.MainPage">

    <VerticalStackLayout>

        <Label x:Name="TodayDate" HorizontalTextAlignment="Start" Margin="15"
               Text="{Binding CurrentDate}" FontSize="24"/>

        <Button x:Name="AddActivityButton" Text="Добавить активность" Margin="15"
                Clicked="AddActivityButton_Clicked" />

        <CollectionView Header="Дефициты сегодня" Margin="15"/>

        <CollectionView Header="Список активностей" Margin="15"/>

        <Button Text="Полный анализ за день" Margin="15"/>

    </VerticalStackLayout>

</ContentPage>
