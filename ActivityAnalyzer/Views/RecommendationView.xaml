<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:ActivityAnalyzer.ViewModel"
             x:Class="ActivityAnalyzer.Pages.RecommendatinView">

    <ContentView.Resources>
        <viewModel:RecommendationViewModel x:Key="ViewModel" />
    </ContentView.Resources>
    <ContentView.BindingContext>
        <StaticResourceExtension Key="ViewModel" />
    </ContentView.BindingContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Text="Рекоммендации" Margin="15,0" FontSize="32"/>

        <CollectionView ItemsSource="{Binding RecommendationList}" Margin="15" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="10,5">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Start">
                            <Label Text="{Binding Category, Converter={StaticResource WheelOfLifeEnumConverter}}"
                               FontAttributes="Bold"
                               FontSize="Medium"/>

                            <HorizontalStackLayout>
                                <Label Text="Важность: " VerticalOptions="Center"/>
                                <Label VerticalOptions="Center"
                                    Text="{Binding Importance, Converter={StaticResource ImportanceEnumConverter}}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout>
                                <Label Text="На протяжении " VerticalOptions="Center"/>
                                <Label VerticalOptions="Center"
                                    Text="{Binding TimeSpentString}"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>
